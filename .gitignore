# 依赖与构建产物
# 注意：必须锚定到仓库根目录。写成裸的 build/ 会连带忽略 src/honet/build/
# 这个真实子包，导致源码无法提交。
/dist/
/build/
/wheels/
*.egg-info/
.eggs/

# uv / 虚拟环境
.venv/
uv.toml.local

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Sphinx 构建产物（CI 会重新生成并部署到 Pages，不入库）
docs/_build/
docs/.doctrees/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地环境变量（切勿提交任何 token）
.env
.env.*

# twine 凭据文件（含明文 token，只提交 .pypirc.example）
.pypirc
